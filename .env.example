# SwarmMemory Configuration

# ── Database ────────────────────────────────────────────────────────────────
SWARM_MEMORY_DB_PATH=swarm_memory.db

# ── Embedding model ─────────────────────────────────────────────────────────
SWARM_MEMORY_EMBED_DIM=768

# ── Hybrid Retrieval (RRF) ──────────────────────────────────────────────────
SWARM_MEMORY_RRF_K=60
SWARM_MEMORY_DENSE_WEIGHT=1.0
SWARM_MEMORY_BM25_WEIGHT=0.8

# Minimum cosine similarity (0.0–1.0) for a fact to be returned by memory_search.
# Facts below this threshold are excluded regardless of ranking.
# 0.60 = 60% similarity (default). Set to 0.0 to disable.
SWARM_MEMORY_RETRIEVAL_MIN_SIMILARITY=0.60

# ── Temporal Confidence Decay ───────────────────────────────────────────────
SWARM_MEMORY_CONFIDENCE_DECAY_RATE=0.01
SWARM_MEMORY_CONFIDENCE_DECAY_FLOOR=0.5

# ── Session Deduplication ───────────────────────────────────────────────────
SWARM_MEMORY_SESSION_TTL=7200

# ── LLM Contradiction Detection ─────────────────────────────────────────────
SWARM_MEMORY_LLM_MODEL=openrouter/anthropic/claude-3.5-sonnet

# API keys for the model (LiteLLM requires the appropriate provider key)
OPENROUTER_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here
